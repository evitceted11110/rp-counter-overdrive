{
  "name": "rp-counter-overdrive",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.app.json && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "sim:gate2": "tsx sim/report.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@rogue-paradise/platform-sdk": "^0.1.0",
    "@rogue-paradise/rng": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rogue-paradise/sim": "^0.1.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
